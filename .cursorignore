# =========================================================================
# Layer 1: Cursor Indexing & Context Exclusion Rules
# Prevents Cursor AI from indexing or embedding sensitive files and secrets.
# =========================================================================

# Environment Variables & Secrets (Allow only the template)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Git Internal & Guardrail Configuration
.git/
.gitignore

# Cryptographic Keys, Certificates, & Keystores
*.pem
*.key
*.keystore
*.jks
*.pfx
*.p12
*.cer
*.crt
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Mobile & Local Secrets Properties
keystore.properties
local.properties

# Cloud, CLI & Service Credentials
credentials.json
client_secret*.json
service-account*.json
.aws/
.gcp/
.azure/
*.publishsettings

# Database Files & Dumps
*.sqlite
*.sqlite3
*.db
*.dump
*.sql

# Dependencies & Build Outputs
node_modules/
.next/
dist/
build/
out/
.turbo/
.cache/
coverage/
.terraform/
target/
vendor/
