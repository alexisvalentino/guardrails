{
  "name": "ai-security-guardrails",
  "version": "1.0.0",
  "description": "Enterprise-grade 5-layer AI security guardrail system to prevent AI coding assistants (Cursor, Copilot, Claude Code, Codex, Antigravity) from leaking secrets, touching .env files, or committing credentials.",
  "type": "module",
  "main": "scripts/check-secrets.mjs",
  "scripts": {
    "security:check": "node scripts/check-secrets.mjs",
    "security:setup": "git config core.hooksPath .githooks",
    "install:to": "node scripts/install-to.mjs",
    "test": "node scripts/test-guardrails.mjs",
    "test:security": "node scripts/check-secrets.mjs"
  },
  "keywords": [
    "ai-guardrails",
    "security",
    "cursor",
    "copilot",
    "claude-code",
    "antigravity",
    "secret-detection",
    "pre-commit-hook",
    "zero-leakage",
    "developer-security"
  ],
  "author": "Alexis Valentino",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
