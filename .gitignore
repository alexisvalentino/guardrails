# -------------------------------------------------------------------------
*.pem
*.key
*.keystore
*.jks
*.pfx
*.p12
*.cer
*.crt
*.der
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
keystore.properties
local.properties

