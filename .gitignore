# =========================================================================
# PROTECTED GITIGNORE - DO NOT MODIFY VIA AUTOMATED AI AGENTS
# =========================================================================
# This file is part of the repository's 5-layer AI security guardrail system.
# AI assistants, copilot tools, and automated agents are strictly forbidden
# from removing or weakening any ignore pattern below.
# =========================================================================

# -------------------------------------------------------------------------
# Environment Variables & Secrets (MANDATORY ZERO-LEAKAGE)
# -------------------------------------------------------------------------
.env
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env

# Explicitly whitelist the public template
!.env.example

