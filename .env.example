# =========================================================================
# THIS IS A TEMPLATE ONLY. DO NOT PUT REAL SECRETS HERE.
# =========================================================================
# Copy this file to .env or .env.local for your local development setup:
#   cp .env.example .env.local
#
# AI assistants, copilot indexers, and git hooks are strictly forbidden
# from reading or modifying your actual .env files.
# =========================================================================

# -------------------------------------------------------------------------
# Application Configuration
# -------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=your_session_secret_min_32_characters_here

# -------------------------------------------------------------------------
# AI Model & Agent Provider Keys (Company or Personal)
# -------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# -------------------------------------------------------------------------
# Database & Cache Connection Strings
# -------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/dbname?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/dbname
REDIS_URL=redis://localhost:6379

# -------------------------------------------------------------------------
# Authentication & Backend Services (e.g. Supabase, NextAuth)
# -------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# -------------------------------------------------------------------------
# Payment & Billing Services (e.g. Stripe)
# -------------------------------------------------------------------------
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# -------------------------------------------------------------------------
# Cloud Storage & Infrastructure (e.g. AWS, S3)
# -------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_s3_bucket_name_here

# -------------------------------------------------------------------------
# Third-Party Integrations & Webhooks
# -------------------------------------------------------------------------
GITHUB_TOKEN=your_github_personal_access_token_here
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
